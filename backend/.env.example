# Server API
PORT=3000
HOST=0.0.0.0

# Sicurezza JWT (genera una stringa casuale lunga es. 64+ char hex)
JWT_SECRET=CAMBIAMI_CON_UNA_CHIAVE_CASUALE_LUNGA

# Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=maglite_user
DB_PASSWORD=CAMBIAMI_PASSWORD_DB
DB_NAME=maglite_db

# NAS Storage via SFTP (WD My Cloud - non committare MAI credenziali reali)
STORAGE_DRIVER=sftp
NAS_SFTP_HOST=192.168.1.20
NAS_SFTP_PORT=22
NAS_SFTP_USER=sshd
NAS_SFTP_PASSWORD=CAMBIAMI_PASSWORD_NAS
NAS_SFTP_BASE_PATH=/shares/Volume_1/gestionale

